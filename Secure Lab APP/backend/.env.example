# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NUNCA vai para o GitHub (está no .gitignore). Este aqui, sem segredos, vai.
# Cada variável fica na sua própria linha, sem aspas e sem espaços em volta do "=".

# --- Banco de dados (PostgreSQL) ---
DB_USER=postgres
DB_PASSWORD=troque_pela_senha_do_seu_postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securelab

# --- Login do administrador (rota POST /auth/login) ---
ADMIN_USERNAME=admin
# Hash bcrypt da senha do admin (NÃO a senha em si). Para gerar:
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('SUA_SENHA'))"
ADMIN_PASSWORD_HASH=cole_aqui_o_hash_bcrypt

# --- Token JWT ---
# Chave aleatória que assina os tokens. Para gerar:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cole_aqui_uma_chave_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
