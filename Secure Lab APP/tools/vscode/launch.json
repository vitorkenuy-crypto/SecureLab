{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API local (sem PostgreSQL)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main_local:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "App no navegador (Edge)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/mobile",
      "deviceId": "edge"
    },
    {
      "name": "API (PostgreSQL)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "App (emulador ou celular)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/mobile"
    }
  ],
  "compounds": [
    {
      "name": "SecureLab (tudo local)",
      "configurations": [
        "API local (sem PostgreSQL)",
        "App no navegador (Edge)"
      ],
      "stopAll": true
    },
    {
      "name": "SecureLab (PostgreSQL + emulador)",
      "configurations": [
        "API (PostgreSQL)",
        "App (emulador ou celular)"
      ],
      "stopAll": true
    }
  ]
}