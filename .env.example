# Configuração do Docker Compose.
# Copie este arquivo para ".env" (nesta mesma pasta, a raiz do repositório) e preencha os valores.
# Ele é separado do backend/.env, que só serve para rodar o backend SEM Docker.
# O ".env" NUNCA vai para o GitHub (está no .gitignore).

# Senha do PostgreSQL que o Docker vai criar. Use letras e números, sem "$" e sem acentos.
DB_PASSWORD=troque_esta_senha

# Login do administrador da API
ADMIN_USERNAME=admin
# Hash bcrypt da senha do admin (veja o backend/README.md para gerar).
# ATENÇÃO: mantenha as ASPAS SIMPLES. Sem elas, o Docker interpreta os "$" do hash e o login nunca funciona.
ADMIN_PASSWORD_HASH='cole_aqui_o_hash_bcrypt'

# Chave que assina os tokens (veja o backend/README.md para gerar)
SECRET_KEY=cole_aqui_uma_chave_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
